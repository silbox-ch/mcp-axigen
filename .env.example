# =============================================================================
# Axigen Server
# =============================================================================
AXIGEN_HOST=mail.example.com
AXIGEN_PORT=443
AXIGEN_USE_SSL=true

# =============================================================================
# Authentication Mode
# =============================================================================
# Choose ONE of these modes:
#
# 1. SINGLE-USER MODE (default) - Use static credentials
#    Set AXIGEN_USERNAME and AXIGEN_PASSWORD below
#
# 2. MULTI-USER (OAuth/OIDC) MODE - Use OIDC provider
#    Set the OIDC_* variables below
#    AXIGEN_USERNAME/PASSWORD become optional (each user provides their own)
# =============================================================================

# Single-user authentication (required if OIDC not configured)
AXIGEN_USERNAME=user@example.com
AXIGEN_PASSWORD=secret

# OR use API token
# AXIGEN_API_TOKEN=xxx

# CalDAV/CardDAV endpoints (if different from default)
# AXIGEN_CALDAV_URL=https://mail.example.com/caldav
# AXIGEN_CARDDAV_URL=https://mail.example.com/carddav

# =============================================================================
# OIDC Provider Configuration (Multi-user mode)
# =============================================================================
# Works with: Cloudron, Keycloak, Authentik, Auth0, Okta, Azure AD, etc.
#
# Discovery URL examples:
# - Cloudron:   https://my.domain.com/.well-known/openid-configuration
# - Keycloak:   https://keycloak.domain.com/realms/REALM/.well-known/openid-configuration
# - Authentik:  https://authentik.domain.com/application/o/APP/.well-known/openid-configuration
# - Auth0:      https://TENANT.auth0.com/.well-known/openid-configuration
# - Okta:       https://ORG.okta.com/.well-known/openid-configuration
# - Azure AD:   https://login.microsoftonline.com/TENANT/v2.0/.well-known/openid-configuration
#
# To enable OAuth, uncomment and fill in ALL of these:
# OIDC_DISCOVERY_URL=https://my.domain.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://mcp.example.com/oauth/callback
# OIDC_SCOPES=openid profile email

# =============================================================================
# Security - Credentials Encryption (required for OAuth mode)
# =============================================================================
# Generate with: openssl rand -hex 32
# CREDENTIALS_ENCRYPTION_KEY=your-64-char-hex-key-here

# File to store encrypted Axigen passwords (default: ./data/axigen-credentials.json)
# CREDENTIALS_FILE=./data/axigen-credentials.json

# =============================================================================
# MCP Server
# =============================================================================
MCP_SERVER_NAME=mcp-axigen
LOG_LEVEL=info

# MCP Transport Mode
# stdio = for Claude Desktop (local)
# sse = for claude.ai / ChatGPT / Gemini (web)
MCP_MODE=stdio

# SSE Mode settings (only used when MCP_MODE=sse)
MCP_PORT=3000
MCP_PUBLIC_URL=https://mcp.example.com
